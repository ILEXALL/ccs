rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function currentUserData() {
      return userDoc(currentUid()).data;
    }

    function isNotBanned() {
      let data = currentUserData();
      return data.get('banned', false) != true
        || (
          data.get('bannedUntil', null) is timestamp
          && data.bannedUntil < request.time
        );
    }

    function isActiveUser() {
      return isSignedIn()
        && currentUserData().get('deleted', false) != true
        && isNotBanned();
    }

    function isAdmin() {
      return isActiveUser() && currentUserData().get('role', 'user') == 'admin';
    }

    function isModerator() {
      return isActiveUser()
        && currentUserData().get('role', 'user') == 'moderator';
    }

    function isStaff() {
      return isAdmin() || isModerator();
    }

    function isGlobalModerator() {
      return isStaff()
        || (
          isActiveUser()
          && currentUserData().get('globalChatModerator', false) == true
        )
        || (
          isActiveUser()
          && currentUserData().get('globalModerator', false) == true
        );
    }

    function isVerifiedOrStaff() {
      return isActiveUser()
        && (
          isStaff()
          || currentUserData().get('verified', false) == true
        );
    }

    function isOwner(userId) {
      return isSignedIn() && currentUid() == userId;
    }

    function isAdminUid(userId) {
      let data = userDoc(userId).data;
      return data.get('role', 'user') == 'admin'
        && data.get('deleted', false) != true
        && data.get('banned', false) != true;
    }

    function isStaffUid(userId) {
      let data = userDoc(userId).data;
      return data.get('role', 'user') in ['admin', 'moderator']
        && data.get('deleted', false) != true
        && data.get('banned', false) != true;
    }

    function validUsername(username) {
      return username is string
        && username.size() >= 3
        && username.size() <= 30
        && username.matches('^[a-zA-Z0-9_]+$');
    }

    function validUsernameKey(username, usernameKey) {
      return usernameKey is string
        && usernameKey == username.lower()
        && usernameKey.matches('^[a-z0-9_]{3,30}$');
    }

    function usernameReservationOwnedBy(userId, username, usernameKey) {
      let reservation = get(
        /databases/$(database)/documents/usernames/$(usernameKey)
      );
      return validUsername(username)
        && validUsernameKey(username, usernameKey)
        && reservation.data.uid == userId
        && reservation.data.username == username
        && reservation.data.usernameKey == usernameKey;
    }

    function validUsernameReservation(usernameKey) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'usernameKey',
          'updatedAt'
        ])
        && request.resource.data.uid == currentUid()
        && validUsername(request.resource.data.username)
        && validUsernameKey(request.resource.data.username, usernameKey)
        && request.resource.data.usernameKey == usernameKey
        && request.resource.data.updatedAt == request.time;
    }

    function selfUsernameValidOrUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'username',
          'usernameKey'
        ])
        || usernameReservationOwnedBy(
          currentUid(),
          request.resource.data.username,
          request.resource.data.usernameKey
        );
    }

    function validMaintenanceConfig() {
      return request.resource.data.keys().hasOnly([
          'maintenanceEnabled',
          'maintenanceTitle',
          'maintenanceMessage',
          'allowAdminBypass',
          'minimumAppVersion',
          'updateContact'
        ])
        && request.resource.data.maintenanceEnabled is bool
        && request.resource.data.maintenanceTitle is string
        && request.resource.data.maintenanceTitle.size() <= 100
        && request.resource.data.maintenanceMessage is string
        && request.resource.data.maintenanceMessage.size() <= 500
        && request.resource.data.allowAdminBypass is bool
        && (
          !request.resource.data.keys().hasAny(['minimumAppVersion'])
          || (
            request.resource.data.minimumAppVersion is string
            && request.resource.data.minimumAppVersion.size() <= 32
          )
        )
        && (
          !request.resource.data.keys().hasAny(['updateContact'])
          || (
            request.resource.data.updateContact is string
            && request.resource.data.updateContact.size() <= 200
          )
        );
    }

    function selfUserEditableKeys() {
      return [
        'uid',
        'name',
        'username',
        'usernameKey',
        'email',
        'photoUrl',
        'bio',
        'avatarPath',
        'city',
        'country',
        'settings',
        'garage',
        'provider',
        'telegramUsername',
        'instagram',
        'tiktok',
        'telegram',
        'reviewNotifications',
        'likeNotifications',
        'commentNotifications',
        'newSpotNotifications',
        'newMessageNotifications',
        'friendAtSpotNotifications',
        'friendLiveShareNotifications',
        'publicProfile',
        'showGarage',
        'fcmTokens',
        'fcmTokenUpdatedAt',
        'lastFcmTokenPlatform',
        'deviceIds',
        'lastDeviceId',
        'lastDevicePlatform',
        'lastDeviceSeenAt',
        'isOnline',
        'lastSeenAt',
        'isSharingLiveLocation',
        'liveLocationExpiresAt',
        'liveLocationShareDurationMinutes',
        'liveLocationVisibleToUserIds',
        'blockedUserIds',
        'updatedAt'
      ];
    }

    function userProtectedFieldsUnchanged() {
      return request.resource.data.get('role', 'user')
          == resource.data.get('role', 'user')
        && request.resource.data.get('verified', false)
          == resource.data.get('verified', false)
        && request.resource.data.get('banned', false)
          == resource.data.get('banned', false)
        && request.resource.data.get('deleted', false)
          == resource.data.get('deleted', false)
        && request.resource.data.uid == resource.data.uid;
    }

    function validNewUser(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.email is string
        && usernameReservationOwnedBy(
          userId,
          request.resource.data.username,
          request.resource.data.usernameKey
        )
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('verified', false) != true
        && request.resource.data.get('banned', false) != true
        && request.resource.data.get('deleted', false) != true;
    }


    function validNewUserReport() {
      return isActiveUser()
        && request.resource.data.keys().hasOnly([
          'reportedUid',
          'reportedUsername',
          'reportedName',
          'reportedEmail',
          'reportedRole',
          'reporterUid',
          'reporterUsername',
          'reporterName',
          'reporterEmail',
          'reason',
          'status',
          'createdAt',
          'createdAtMillis',
          'updatedAt'
        ])
        && request.resource.data.reporterUid == currentUid()
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid.size() > 0
        && request.resource.data.reportedUid != currentUid()
        && exists(
          /databases/$(database)/documents/users/$(request.resource.data.reportedUid)
        )
        && request.resource.data.reportedUsername is string
        && request.resource.data.reportedUsername.size() <= 80
        && request.resource.data.reportedName is string
        && request.resource.data.reportedName.size() <= 120
        && request.resource.data.reportedEmail is string
        && request.resource.data.reportedEmail.size() <= 200
        && request.resource.data.reportedRole is string
        && request.resource.data.reportedRole in [
          'user',
          'admin',
          'moderator'
        ]
        && request.resource.data.reporterUsername is string
        && request.resource.data.reporterUsername.size() >= 1
        && request.resource.data.reporterUsername.size() <= 80
        && request.resource.data.reporterName is string
        && request.resource.data.reporterName.size() <= 120
        && request.resource.data.reporterEmail is string
        && request.resource.data.reporterEmail.size() <= 200
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdAtMillis is int
        && request.resource.data.createdAtMillis > 0
        && request.resource.data.updatedAt == request.time;
    }

    function userReportIdentityUnchanged() {
      return request.resource.data.reportedUid == resource.data.reportedUid
        && request.resource.data.reportedUsername == resource.data.reportedUsername
        && request.resource.data.reportedName == resource.data.reportedName
        && request.resource.data.reportedEmail == resource.data.reportedEmail
        && request.resource.data.reportedRole == resource.data.reportedRole
        && request.resource.data.reporterUid == resource.data.reporterUid
        && request.resource.data.reporterUsername == resource.data.reporterUsername
        && request.resource.data.reporterName == resource.data.reporterName
        && request.resource.data.reporterEmail == resource.data.reporterEmail
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdAtMillis == resource.data.createdAtMillis;
    }

    function moderatorCanUpdateUser() {
      return isModerator()
        && resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('role', 'user')
          == resource.data.get('role', 'user')
        && request.resource.data.get('verified', false)
          == resource.data.get('verified', false)
        && request.resource.data.get('deleted', false)
          == resource.data.get('deleted', false)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'banned',
          'bannedUntil',
          'banReason',
          'bannedByUid',
          'bannedBy',
          'bannedAt',
          'unbannedByUid',
          'unbannedBy',
          'unbannedAt',
          'updatedAt'
        ]);
    }

    function canReadSpot() {
      return isActiveUser()
        && (
          isStaff()
          || resource.data.addedByUid == currentUid()
          || (
            resource.data.status == 'approved'
            && (
              resource.data.get('verifiedOnly', false) != true
              || isVerifiedOrStaff()
            )
          )
        );
    }

    function validNewSpot() {
      return request.resource.data.addedByUid == currentUid()
        && request.resource.data.name is string
        && request.resource.data.cityCountry is string
        && request.resource.data.categories is list
        && request.resource.data.status in ['pending', 'approved']
        && (
          request.resource.data.status == 'pending'
          || isStaff()
        )
        && (
          request.resource.data.get('verifiedOnly', false) != true
          || isVerifiedOrStaff()
        )
        && (
          isStaff()
          || (
            request.resource.data.get('ownerUid', '') == ''
            && request.resource.data.get('ownerUsername', '') == ''
            && request.resource.data.get('rating', 0) == 0
          )
        );
    }

    function ownerCanEditSpot() {
      return isActiveUser()
        && resource.data.addedByUid == currentUid()
        && request.resource.data.addedByUid == resource.data.addedByUid
        && request.resource.data.status == 'edited'
        && (
          request.resource.data.get('verifiedOnly', false) != true
          || isVerifiedOrStaff()
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'cityCountry',
          'description',
          'lat',
          'lng',
          'coordinates',
          'categories',
          'reelLink',
          'contactPhone',
          'contactInstagram',
          'contactEmail',
          'openingHours',
          'photoUrl',
          'photoUrls',
          'verifiedOnly',
          'isTemporary',
          'startsAt',
          'expiresAt',
          'showOnMapAt',
          'status',
          'editReviewStatus',
          'editChangeSummary',
          'editedBy',
          'editedByUid',
          'editedAt',
          'updatedAt'
        ]);
    }

    function businessOwnerCanEditSpot() {
      return isActiveUser()
        && resource.data.get('ownerUid', '') == currentUid()
        && request.resource.data.get('ownerUid', '')
          == resource.data.get('ownerUid', '')
        && request.resource.data.get('businessEditedByUid', '') == currentUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'contactPhone',
          'contactInstagram',
          'contactEmail',
          'openingHours',
          'businessEditedBy',
          'businessEditedByUid',
          'businessEditedAt',
          'updatedAt'
        ]);
    }

    function signedInUserCanRefreshSpotRating() {
      return isActiveUser()
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.ratingCount is int
        && request.resource.data.ratingCount >= 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating',
          'ratingCount',
          'reviewCount',
          'reviewUpdatedAt',
          'updatedAt'
        ]);
    }

    function signedInUserCanUpdateSpotCounters() {
      return isActiveUser()
        && request.resource.data.get('likeCount', 0) is int
        && request.resource.data.get('likeCount', 0) >= 0
        && request.resource.data.get('commentCount', 0) is int
        && request.resource.data.get('commentCount', 0) >= 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likeCount',
          'commentCount',
          'updatedAt'
        ]);
    }

    function listChangedOnlyByCurrentUser(before, after) {
      return after.toSet().difference(before.toSet()).hasOnly([currentUid()])
        && before.toSet().difference(after.toSet()).hasOnly([currentUid()]);
    }

    function listAddedOnlyByCurrentUser(before, after) {
      return after.toSet().difference(before.toSet()).hasOnly([currentUid()])
        && before.toSet().difference(after.toSet()).hasOnly([]);
    }

    function policeReportIdentityUnchanged() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.lat == resource.data.lat
        && request.resource.data.lng == resource.data.lng
        && request.resource.data.coordinates == resource.data.coordinates
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt;
    }

    function policeReportRemovalAllowed() {
      return request.resource.data.status != 'removed'
        || resource.data.uid == currentUid()
        || isStaff()
        || (
          currentUid() in request.resource.data.notThereBy
          && request.resource.data.notThereBy.size() >= 3
        );
    }

    function validNewSosReport(reportId) {
      return reportId == currentUid()
        && request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'description',
          'reason',
          'lat',
          'lng',
          'coordinates',
          'createdAt',
          'expiresAt',
          'updatedAt',
          'confirmationRequestedAt',
          'status'
        ])
        && request.resource.data.uid == currentUid()
        && request.resource.data.username is string
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 12
        && request.resource.data.description.size() <= 500
        && request.resource.data.reason in [
          'battery',
          'tire',
          'fuel',
          'towing',
          'breakdown',
          'other'
        ]
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat >= -90
        && request.resource.data.lat <= 90
        && request.resource.data.lng >= -180
        && request.resource.data.lng <= 180
        && request.resource.data.coordinates is latlng
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt
          <= request.time + duration.value(13, 'h')
        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('confirmationRequestedAt', null) == null
        && request.resource.data.status == 'active';
    }

    function ownerCanRestartSos(reportId) {
      return isActiveUser()
        && resource.data.uid == currentUid()
        && validNewSosReport(reportId)
        && (
          (
            resource.data.status == 'removed'
            && resource.data.updatedAt is timestamp
            && resource.data.updatedAt + duration.value(1, 'm') <= request.time
          )
          || (
            resource.data.expiresAt is timestamp
            && resource.data.expiresAt <= request.time
          )
        );
    }

    function isFriendRequestParticipant() {
      return isSignedIn()
        && (
          resource.data.fromUid == currentUid()
          || resource.data.toUid == currentUid()
          || isAdmin()
        );
    }

    function isFriendshipParticipant() {
      return isSignedIn()
        && (
          currentUid() in resource.data.userIds
          || isAdmin()
        );
    }

    function friendshipAccepted(firstUid, secondUid) {
      return (
        existsAfter(
          /databases/$(database)/documents/friend_requests/$(firstUid + '_' + secondUid)
        )
        && getAfter(
          /databases/$(database)/documents/friend_requests/$(firstUid + '_' + secondUid)
        ).data.status == 'accepted'
      ) || (
        existsAfter(
          /databases/$(database)/documents/friend_requests/$(secondUid + '_' + firstUid)
        )
        && getAfter(
          /databases/$(database)/documents/friend_requests/$(secondUid + '_' + firstUid)
        ).data.status == 'accepted'
      );
    }

    function chatData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function isChatMember(chatId) {
      return isSignedIn()
        && chatExists(chatId)
        && currentUid() in chatData(chatId).memberIds;
    }

    function chatExists(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId));
    }

    function chatOwnerUid(chatId) {
      let data = chatData(chatId);
      return data.get('ownerUid', data.memberIds[0]);
    }

    function isChatOwner(chatId) {
      return isSignedIn() && currentUid() == chatOwnerUid(chatId);
    }

    function isChatModerator(chatId) {
      return isSignedIn()
        && currentUid() in chatData(chatId).get('moderatorIds', []);
    }

    function canManageChat(chatId) {
      return isChatOwner(chatId) || isChatModerator(chatId) || isStaff();
    }

    function canOverridePrivateGroup(chatId) {
      return isChatOwner(chatId) || isStaff() || isGlobalModerator();
    }

    function canManageChatMembers(chatId) {
      let data = chatData(chatId);
      return (
          data.get('isPrivate', false) != true
          && canManageChat(chatId)
        ) || canOverridePrivateGroup(chatId);
    }

    function forumTopicData(topicId) {
      return get(/databases/$(database)/documents/forum_topics/$(topicId)).data;
    }

    function canManageForumTopic(topicId) {
      return isStaff()
        || isGlobalModerator()
        || (
          isActiveUser()
          && forumTopicData(topicId).authorId == currentUid()
        );
    }


    function temporarySpotData(spotId) {
      return get(/databases/$(database)/documents/spots/$(spotId)).data;
    }

    function validTemporarySpotAutoForumTopicCreate(topicId) {
      let data = request.resource.data;
      let spot = temporarySpotData(data.spotId);
      return data.source == 'temporary_spot'
        && data.get('isSpotTopic', true) == true
        && data.spotId is string
        && data.spotId.size() >= 1
        && exists(/databases/$(database)/documents/spots/$(data.spotId))
        && topicId == 'temporary_spot_' + data.spotId
        && data.temporarySpotId == data.spotId
        && spot.get('isTemporary', false) == true
        && spot.expiresAt is timestamp
        && spot.expiresAt > request.time
        && spot.status in ['approved', 'pending']
        && data.authorId == spot.addedByUid
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 80
        && data.title == spot.name
        && data.avatarUrl == spot.photoUrl
        && data.categoryId == 'meets_events'
        && data.temporarySpotStartsAt == spot.startsAt
        && data.temporarySpotExpiresAt == spot.expiresAt
        && data.autoExpiresAt == spot.expiresAt
        && (
          (
            spot.status == 'approved'
            && data.status == 'approved'
            && data.rejectionReason == null
            && data.reviewedBy == currentUid()
            && data.reviewedAt == request.time
          )
          || (
            spot.status == 'pending'
            && data.status == 'pending'
            && data.rejectionReason == null
            && data.reviewedBy == null
            && data.reviewedAt == null
          )
        );
    }

    function chatMembershipUnchanged() {
      return request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == resource.data.memberIds.size()
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && request.resource.data.isGroup == resource.data.isGroup;
    }

    function managedGroupChatUpdateAllowed(chatId) {
      let ownerUid = chatOwnerUid(chatId);
      return (canManageChat(chatId) || isGlobalModerator())
        && resource.data.get('isGroup', false) == true
        && request.resource.data.get('isGroup', false) == true
        && request.resource.data.get('ownerUid', ownerUid) == ownerUid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 1
        && ownerUid in request.resource.data.memberIds
        && request.resource.data.get('moderatorIds', []) is list
        && request.resource.data.memberIds.hasAll(
          request.resource.data.get('moderatorIds', [])
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'memberIds',
            'memberUsernames',
            'memberPhotoUrls'
          ])
          || canManageChatMembers(chatId)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isPrivate'
          ])
          || canOverridePrivateGroup(chatId)
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'photoUrl',
          'avatarUrl',
          'description',
          'memberIds',
          'memberUsernames',
          'memberPhotoUrls',
          'moderatorIds',
          'isPrivate',
          'hiddenForUserIds',
          'lastMessage',
          'lastSenderUid',
          'lastSenderUsername',
          'updatedAt'
        ]);
    }

    function chatHiddenForChangedOnlyByCurrentUser() {
      return request.resource.data.get('hiddenForUserIds', []) is list
        && resource.data.get('hiddenForUserIds', []) is list
        && listChangedOnlyByCurrentUser(
          resource.data.get('hiddenForUserIds', []),
          request.resource.data.get('hiddenForUserIds', [])
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'hiddenForUserIds'
        ]);
    }

    function currentUserLeavesGroupOnly(chatId) {
      return resource.data.get('isGroup', false) == true
        && request.resource.data.get('isGroup', false) == true
        && currentUid() != chatOwnerUid(chatId)
        && currentUid() in resource.data.memberIds
        && !(currentUid() in request.resource.data.memberIds)
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 1
        && request.resource.data.memberIds.toSet()
          .difference(resource.data.memberIds.toSet()).hasOnly([])
        && resource.data.memberIds.toSet()
          .difference(request.resource.data.memberIds.toSet()).hasOnly([
            currentUid()
          ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberIds',
          'memberUsernames',
          'memberPhotoUrls',
          'moderatorIds',
          'updatedAt'
        ]);
    }

    function userBlocks(blockerUid, blockedUid) {
      return blockedUid in get(
        /databases/$(database)/documents/users/$(blockerUid)
      ).data.get('blockedUserIds', []);
    }

    function directMemberIdsBlocked(memberIds) {
      return memberIds is list
        && memberIds.size() == 2
        && (
          userBlocks(memberIds[0], memberIds[1])
          || userBlocks(memberIds[1], memberIds[0])
        );
    }

    function directChatBlocked(chatId) {
      let data = chatData(chatId);
      return data.get('isGroup', false) != true
        && directMemberIdsBlocked(data.memberIds);
    }

    function chatMessageReadReceiptUpdateOnly() {
      return resource.data.senderUid != currentUid()
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'readByUserIds'
        ])
        && resource.data.get('readByUserIds', []) is list
        && request.resource.data.get('readByUserIds', []) is list
        && listAddedOnlyByCurrentUser(
          resource.data.get('readByUserIds', []),
          request.resource.data.get('readByUserIds', [])
        );
    }

    function notificationTargetsSpotOwner() {
      let spot = get(
        /databases/$(database)/documents/spots/$(request.resource.data.spotId)
      ).data;
      return request.resource.data.userId == spot.addedByUid
        || request.resource.data.userId == spot.get('ownerUid', '');
    }

    function validSpotLikeNotification() {
      let data = request.resource.data;
      return data.type == 'spot_like'
        && data.spotId is string
        && exists(/databases/$(database)/documents/spots/$(data.spotId))
        && notificationTargetsSpotOwner()
        && exists(
          /databases/$(database)/documents/spot_likes/$(data.spotId + '_' + currentUid())
        );
    }

    function validSpotCommentNotification() {
      let data = request.resource.data;
      let review = get(
        /databases/$(database)/documents/spot_reviews/$(data.reviewId)
      ).data;
      return data.type == 'spot_comment'
        && data.spotId is string
        && data.reviewId is string
        && exists(/databases/$(database)/documents/spots/$(data.spotId))
        && exists(/databases/$(database)/documents/spot_reviews/$(data.reviewId))
        && review.userId == currentUid()
        && review.spotId == data.spotId
        && notificationTargetsSpotOwner();
    }

    function validChatMessageNotification() {
      let data = request.resource.data;
      return data.type == 'chat_message'
        && data.chatId is string
        && currentUid() in chatData(data.chatId).memberIds
        && data.userId in chatData(data.chatId).memberIds;
    }

    function validFriendRequestNotification() {
      let data = request.resource.data;
      return data.type == 'friend_request'
        && data.friendRequestId is string
        && data.fromUid == currentUid()
        && exists(
          /databases/$(database)/documents/friend_requests/$(data.friendRequestId)
        )
        && get(
          /databases/$(database)/documents/friend_requests/$(data.friendRequestId)
        ).data.fromUid == currentUid()
        && get(
          /databases/$(database)/documents/friend_requests/$(data.friendRequestId)
        ).data.toUid == data.userId
        && get(
          /databases/$(database)/documents/friend_requests/$(data.friendRequestId)
        ).data.status == 'pending';
    }

    function validFriendLocationNotification() {
      let data = request.resource.data;
      return data.type in ['friend_at_spot', 'friend_live_sharing']
        && data.userId is string
        && data.userId != currentUid()
        && data.actorUserId == currentUid()
        && data.friendUid == currentUid()
        && data.friendUsername is string
        && data.title is string
        && data.body is string
        && data.read == false
        && data.friendLat is number
        && data.friendLng is number
        && data.friendCoordinates is latlng
        && data.distanceMeters is int
        && data.lastNotifiedAtMillis is int
        && friendshipAccepted(currentUid(), data.userId)
        && (
          data.type != 'friend_at_spot'
          || (
            data.spotId is string
            && data.spotName is string
            && data.spotCategory is string
          )
        );
    }

    function validFriendLocationNotificationRefresh() {
      let data = request.resource.data;
      return validFriendLocationNotification()
        && resource.data.userId == data.userId
        && resource.data.actorUserId == data.actorUserId
        && resource.data.friendUid == data.friendUid
        && resource.data.type == data.type;
    }

    function validSpotPendingReviewNotification() {
      let data = request.resource.data;
      let spot = get(
        /databases/$(database)/documents/spots/$(data.spotId)
      ).data;
      return data.type == 'spot_pending_review'
        && data.spotId is string
        && exists(/databases/$(database)/documents/spots/$(data.spotId))
        && spot.addedByUid == currentUid()
        && spot.status == 'pending'
        && isAdminUid(data.userId);
    }

    function validUserReportAdminNotification() {
      let data = request.resource.data;
      return isActiveUser()
        && data.keys().hasOnly([
          'userId',
          'type',
          'title',
          'body',
          'actorUserId',
          'actorUsername',
          'reportedUid',
          'reportedUsername',
          'reportId',
          'reason',
          'read',
          'createdAt',
          'createdAtMillis'
        ])
        && data.userId is string
        && isStaffUid(data.userId)
        && data.userId != currentUid()
        && data.type == 'user_report_new'
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.body is string
        && data.body.size() >= 1
        && data.body.size() <= 1200
        && data.actorUserId == currentUid()
        && data.actorUsername is string
        && data.actorUsername.size() >= 1
        && data.actorUsername.size() <= 80
        && data.reportedUid is string
        && data.reportedUid.size() > 0
        && data.reportedUid != currentUid()
        && exists(/databases/$(database)/documents/users/$(data.reportedUid))
        && data.reportedUsername is string
        && data.reportedUsername.size() <= 80
        && data.reportId is string
        && data.reportId.size() > 0
        && exists(/databases/$(database)/documents/user_reports/$(data.reportId))
        && data.reason is string
        && data.reason.size() >= 1
        && data.reason.size() <= 1000
        && data.read == false
        && data.createdAt == request.time
        && data.createdAtMillis is int
        && data.createdAtMillis > 0;
    }

    function validUserNotificationCreate() {
      let data = request.resource.data;
      return isActiveUser()
        && data.userId is string
        && data.userId != currentUid()
        && data.actorUserId == currentUid()
        && data.type is string
        && data.title is string
        && data.body is string
        && data.read == false
        && (
          isStaff()
          || validSpotLikeNotification()
          || validSpotCommentNotification()
          || validSpotPendingReviewNotification()
          || validChatMessageNotification()
          || validFriendRequestNotification()
          || validFriendLocationNotification()
        );
    }

    match /app_config/{configId} {
      allow read: if configId in ['main', 'global_chat'];
      allow create, update: if (
          configId == 'main'
          && isAdmin()
          && validMaintenanceConfig()
        ) || (
          configId == 'global_chat'
          && isAdmin()
          && request.resource.data.keys().hasOnly([
            'moderatorIds',
            'globalModeratorIds',
            'updatedAt'
          ])
          && request.resource.data.get('moderatorIds', []) is list
          && request.resource.data.get('globalModeratorIds', []) is list
        );
      allow delete: if configId in ['main', 'global_chat'] && isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && validNewUser(userId);
      allow update: if (
        isOwner(userId)
        && isActiveUser()
        && userProtectedFieldsUnchanged()
        && selfUsernameValidOrUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(selfUserEditableKeys())
      ) || isAdmin() || moderatorCanUpdateUser();
      allow delete: if isAdmin();
    }

    match /device_bans/{deviceId} {
      // A signed-in app instance may directly check its own generated device-ban document.
      // Listing is staff-only so users cannot browse banned devices.
      allow get: if isSignedIn();
      allow list: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly([
          'deviceId',
          'userId',
          'username',
          'email',
          'reason',
          'banned',
          'bannedByUid',
          'bannedBy',
          'bannedAt',
          'updatedAt',
          'platform'
        ])
        && request.resource.data.deviceId == deviceId
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() >= 8
        && request.resource.data.deviceId.size() <= 128
        && request.resource.data.get('banned', true) == true;
      allow delete: if isStaff();
    }

    match /usernames/{usernameKey} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && validUsernameReservation(usernameKey);
      allow update: if isActiveUser()
        && resource.data.uid == currentUid()
        && validUsernameReservation(usernameKey)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid',
          'username',
          'usernameKey',
          'updatedAt'
        ]);
      allow delete: if isAdmin()
        || (isActiveUser() && resource.data.uid == currentUid());
    }

    match /spots/{spotId} {
      allow read: if canReadSpot();
      allow create: if isActiveUser() && validNewSpot();
      allow update: if isStaff()
        || ownerCanEditSpot()
        || businessOwnerCanEditSpot()
        || signedInUserCanRefreshSpotRating()
        || signedInUserCanUpdateSpotCounters();
      allow delete: if isStaff();
    }

    match /spot_reviews/{reviewId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.userId == currentUid()
        && request.resource.data.spotId is string
        && request.resource.data.username is string
        && (
          request.resource.data.get('type', 'comment')
            in ['comment', 'rating']
        );
      allow update: if isActiveUser()
        && resource.data.userId == currentUid()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.get('spotId', '') == resource.data.get('spotId', '')
        && request.resource.data.username == resource.data.username
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'comment',
          'rating',
          'ratingDayKey',
          'edited',
          'updatedAt'
        ]);
      allow delete: if isActiveUser()
        && (resource.data.userId == currentUid() || isStaff());
    }

    match /spot_comment_daily_counts/{countId} {
      allow get: if isActiveUser();
      allow list: if false;
      allow create: if isActiveUser()
        && request.resource.data.userId == currentUid()
        && request.resource.data.spotId is string
        && request.resource.data.dayKey is string
        && request.resource.data.count is int
        && request.resource.data.count >= 1
        && request.resource.data.count <= 5
        && request.resource.data.keys().hasOnly([
          'spotId',
          'userId',
          'dayKey',
          'count',
          'createdAt',
          'updatedAt'
        ]);
      allow update: if isActiveUser()
        && resource.data.userId == currentUid()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.get('spotId', '') == resource.data.get('spotId', '')
        && request.resource.data.dayKey == resource.data.dayKey
        && request.resource.data.count is int
        && request.resource.data.count >= resource.data.count
        && request.resource.data.count <= 5
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'count',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /spot_likes/{likeId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.userId == currentUid()
        && request.resource.data.get('targetType', 'spot') == 'spot'
        && request.resource.data.get('spotId', '') != '';
      allow delete: if isActiveUser()
        && (resource.data.userId == currentUid() || isStaff());
      allow update: if false;
    }

    match /police_reports/{reportId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.uid == currentUid()
        && request.resource.data.username is string
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.coordinates is latlng
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.status == 'active'
        && request.resource.data.stillThereBy is list
        && request.resource.data.notThereBy is list
        && request.resource.data.stillThereBy.size() == 0
        && request.resource.data.notThereBy.size() == 0;
      allow update: if isActiveUser()
        && policeReportIdentityUnchanged()
        && request.resource.data.status in ['active', 'removed']
        && request.resource.data.stillThereBy is list
        && request.resource.data.notThereBy is list
        && listChangedOnlyByCurrentUser(
          resource.data.stillThereBy,
          request.resource.data.stillThereBy
        )
        && listChangedOnlyByCurrentUser(
          resource.data.notThereBy,
          request.resource.data.notThereBy
        )
        && policeReportRemovalAllowed()
        && (
          !request.resource.data.keys().hasAny(['removedByUid'])
          || request.resource.data.removedByUid == currentUid()
          || isStaff()
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'stillThereBy',
          'notThereBy',
          'updatedAt',
          'status',
          'removedByUid',
          'removedAt'
        ]);
      allow delete: if isStaff();
    }

    match /sos_reports/{reportId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && validNewSosReport(reportId);
      allow update: if ownerCanRestartSos(reportId)
        || (
          isActiveUser()
          && (resource.data.uid == currentUid() || isStaff())
          && resource.data.status == 'active'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.username == resource.data.username
          && request.resource.data.lat == resource.data.lat
          && request.resource.data.lng == resource.data.lng
          && request.resource.data.coordinates == resource.data.coordinates
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.reason == resource.data.reason
          && request.resource.data.description == resource.data.description
          && request.resource.data.status in ['active', 'removed']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt',
            'confirmationRequestedAt',
            'removedByUid',
            'removedAt'
          ])
          && (
            !request.resource.data.keys().hasAny(['removedByUid'])
            || request.resource.data.removedByUid == currentUid()
            || isStaff()
          )
        );
      allow delete: if isStaff();
    }

    match /live_locations/{userId} {
      allow read: if isActiveUser()
        && (
          userId == currentUid()
          || isStaff()
          || currentUid() in resource.data.visibleToUserIds
          || '__public__' in resource.data.visibleToUserIds
        );
      allow create, update: if isOwner(userId)
        && isActiveUser()
        && request.resource.data.uid == currentUid()
        && request.resource.data.username is string
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.coordinates is latlng
        && request.resource.data.visibleToUserIds is list
        && currentUid() in request.resource.data.visibleToUserIds
        && request.resource.data.expiresAt is timestamp;
      allow delete: if isOwner(userId) || isStaff();
    }

    match /meet_notifications/{notificationId} {
      allow read: if isActiveUser()
        && resource.data.userId == currentUid();
      allow create: if isStaff()
        && request.resource.data.userId is string
        && request.resource.data.spotId is string
        && request.resource.data.spotName is string
        && request.resource.data.read == false;
      allow update: if isActiveUser()
        && resource.data.userId == currentUid()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.get('spotId', '') == resource.data.get('spotId', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read',
          'readAt'
        ]);
      allow delete: if isStaff()
        || (isActiveUser() && resource.data.userId == currentUid());
    }

    match /admin_notifications/{notificationId} {
      allow read: if isActiveUser()
        && resource.data.userId == currentUid();
      allow create: if (
          isActiveUser()
          && request.resource.data.userId is string
          && isAdminUid(request.resource.data.userId)
          && request.resource.data.type is string
          && request.resource.data.spotId is string
          && request.resource.data.spotName is string
          && request.resource.data.read == false
          && (
            isStaff()
            || (
              request.resource.data.type == 'spot_pending_review'
              && request.resource.data.addedByUid == currentUid()
            )
          )
        ) || validUserReportAdminNotification();
      allow update: if isActiveUser()
        && resource.data.userId == currentUid()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.get('spotId', '') == resource.data.get('spotId', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read',
          'readAt'
        ]);
      allow delete: if isStaff()
        || (isActiveUser() && resource.data.userId == currentUid());
    }

    match /user_notifications/{notificationId} {
      allow read: if isActiveUser()
        && resource.data.userId == currentUid();
      allow create: if validUserNotificationCreate();
      allow update: if (
        isActiveUser()
        && resource.data.userId == currentUid()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read',
          'readAt'
        ])
      ) || (
        isActiveUser()
        && validFriendLocationNotificationRefresh()
      );
      allow delete: if isStaff()
        || (isActiveUser() && resource.data.userId == currentUid());
    }

    match /project_news/{newsId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /friend_location_notifications/{notificationId} {
      allow read: if isActiveUser()
        && resource.data.userId == currentUid();
      allow create: if isActiveUser()
        && request.resource.data.userId == currentUid()
        && request.resource.data.friendUid is string
        && request.resource.data.friendUid != currentUid()
        && request.resource.data.friendUsername is string
        && request.resource.data.type in ['friend_nearby', 'friend_at_spot', 'friend_live_sharing']
        && request.resource.data.read == false;
      allow update: if isActiveUser()
        && resource.data.userId == currentUid()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.friendUid == resource.data.friendUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'friendUsername',
          'friendName',
          'friendLat',
          'friendLng',
          'friendCoordinates',
          'type',
          'distanceMeters',
          'spotId',
          'spotName',
          'spotCategory',
          'read',
          'readAt',
          'lastNotifiedAtMillis',
          'createdAt',
          'updatedAt'
        ]);
      allow delete: if isStaff()
        || (isActiveUser() && resource.data.userId == currentUid());
    }

    match /friend_requests/{requestId} {
      allow read: if isFriendRequestParticipant();
      allow create: if isActiveUser()
        && request.resource.data.fromUid == currentUid()
        && request.resource.data.toUid is string
        && request.resource.data.toUid != currentUid()
        && request.resource.data.fromUsername is string
        && request.resource.data.toUsername is string
        && request.resource.data.status == 'pending';
      allow update: if isActiveUser()
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'respondedAt',
          'updatedAt'
        ])
        && (
          (
            resource.data.toUid == currentUid()
            && request.resource.data.status in ['accepted', 'declined']
          )
          || isStaff()
        );
      allow delete: if isActiveUser()
        && (
          resource.data.fromUid == currentUid()
          || resource.data.toUid == currentUid()
          || isStaff()
        );
    }

    match /friendships/{friendshipId} {
      allow read: if isFriendshipParticipant();
      allow create: if isActiveUser()
        && request.resource.data.userIds is list
        && request.resource.data.userIds.size() == 2
        && currentUid() in request.resource.data.userIds
        && friendshipAccepted(
          request.resource.data.userIds[0],
          request.resource.data.userIds[1]
        );
      allow update: if false;
      allow delete: if isFriendshipParticipant();
    }

    match /blocked_users/{blockId} {
      allow get: if isActiveUser()
        && (
          !exists(/databases/$(database)/documents/blocked_users/$(blockId))
          || resource.data.blockerUid == currentUid()
          || resource.data.blockedUid == currentUid()
        );
      allow list: if isActiveUser()
        && resource.data.blockerUid == currentUid();
      allow create: if isActiveUser()
        && request.resource.data.blockerUid == currentUid()
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != currentUid()
        && blockId == currentUid() + '_' + request.resource.data.blockedUid
        && request.resource.data.keys().hasOnly([
          'blockerUid',
          'blockedUid',
          'blockedUsername',
          'blockedName',
          'blockedPhotoUrl',
          'createdAt',
          'updatedAt'
        ]);
      allow update: if isActiveUser()
        && resource.data.blockerUid == currentUid()
        && request.resource.data.blockerUid == resource.data.blockerUid
        && request.resource.data.blockedUid == resource.data.blockedUid
        && blockId == currentUid() + '_' + resource.data.blockedUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'blockerUid',
          'blockedUid',
          'blockedUsername',
          'blockedName',
          'blockedPhotoUrl',
          'createdAt',
          'updatedAt'
        ]);
      allow delete: if isActiveUser()
        && resource.data.blockerUid == currentUid();
    }

    match /chats/{chatId} {
      allow get: if isSignedIn()
        && (
          !chatExists(chatId)
          || currentUid() in resource.data.memberIds
        );
      allow list: if isSignedIn()
        && currentUid() in resource.data.memberIds;
      allow create: if isActiveUser()
        && request.resource.data.memberIds is list
        && currentUid() in request.resource.data.memberIds
        && request.resource.data.memberIds.size() >= 2
        && (
          request.resource.data.get('isGroup', false) == true
          || !directMemberIdsBlocked(request.resource.data.memberIds)
        );
      allow update: if isSignedIn()
        && (
          (
            currentUid() in resource.data.memberIds
            && (
              (
                !directChatBlocked(chatId)
                && (
                  (
                    chatMembershipUnchanged()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'lastMessage',
                      'lastSenderUid',
                      'lastSenderUsername',
                      'hiddenForUserIds',
                      'updatedAt'
                    ])
                  )
                  || managedGroupChatUpdateAllowed(chatId)
                  || currentUserLeavesGroupOnly(chatId)
                )
              )
              || chatHiddenForChangedOnlyByCurrentUser()
            )
          )
          || (
            resource.data.get('isGroup', false) == true
            && (isStaff() || isGlobalModerator())
            && managedGroupChatUpdateAllowed(chatId)
          )
        );
      allow delete: if isStaff()
        || (
          isSignedIn()
          && resource.data.get('isGroup', false) == true
          && currentUid() == resource.data.get(
            'ownerUid',
            resource.data.memberIds[0]
          )
        );

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && !directChatBlocked(chatId)
          && request.resource.data.senderUid == currentUid()
          && request.resource.data.senderUsername is string
          && request.resource.data.text is string
          && (
            request.resource.data.text.size() >= 1
            || request.resource.data.get('photoUrl', request.resource.data.get('imageUrl', '')) is string
          )
          && (
            !request.resource.data.keys().hasAny(['photoUrl'])
            || (
              request.resource.data.photoUrl is string
              && request.resource.data.photoUrl.size() >= 1
              && request.resource.data.photoUrl.size() <= 1500
            )
          )
          && (
            !request.resource.data.keys().hasAny(['imageUrl'])
            || (
              request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.size() >= 1
              && request.resource.data.imageUrl.size() <= 1500
            )
          );
        allow update: if isChatMember(chatId)
          && (
            (
              resource.data.senderUid == currentUid()
              && request.resource.data.senderUid == resource.data.senderUid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'text',
                'edited',
                'updatedAt'
              ])
            )
            || chatMessageReadReceiptUpdateOnly()
          );
        allow delete: if (
          isChatMember(chatId)
          && resource.data.senderUid == currentUid()
        ) || canManageChat(chatId) || isGlobalModerator();
      }
    }

    match /global_chat/{messageId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'userId',
          'username',
          'avatarUrl',
          'role',
          'verified',
          'globalChatModerator',
          'globalModerator',
          'text',
          'photoUrl',
          'imageUrl',
          'timestamp',
          'type'
        ])
        && request.resource.data.userId == currentUid()
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1
        && request.resource.data.username.size() <= 40
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 1000
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.type in ['text', 'image']
        && (
          (
            request.resource.data.type == 'text'
            && request.resource.data.text.size() >= 1
          )
          || (
            request.resource.data.type == 'image'
            && request.resource.data.get('photoUrl', request.resource.data.get('imageUrl', '')) is string
            && request.resource.data.get('photoUrl', request.resource.data.get('imageUrl', '')).size() >= 1
            && request.resource.data.get('photoUrl', request.resource.data.get('imageUrl', '')).size() <= 1500
          )
        )
        && request.resource.data.timestamp == request.time;
      allow update: if false;
      allow delete: if isGlobalModerator()
        || (
          isActiveUser()
          && resource.data.userId == currentUid()
        );
    }


    match /user_reports/{reportId} {
      allow read: if isStaff();

      allow create: if validNewUserReport();

      allow update: if isStaff()
        && userReportIdentityUnchanged()
        && request.resource.data.status in ['open', 'reviewed', 'resolved']
        && request.resource.data.get('reviewedByUid', currentUid()) == currentUid()
        && request.resource.data.get('reviewedBy', '') is string
        && request.resource.data.get('reviewedBy', '').size() <= 80
        && request.resource.data.get('reviewedAt', request.time) == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'reviewedByUid',
          'reviewedBy',
          'reviewedAt',
          'updatedAt'
        ]);

      allow delete: if isStaff();
    }

    match /moderation_logs/{logId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /forum_topics/{topicId} {
      allow read: if isActiveUser();

      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'title',
          'category',
          'description',
          'avatarUrl',
          'categoryId',
          'authorId',
          'authorName',
          'authorRole',
          'authorVerified',
          'authorGlobalChatModerator',
          'authorGlobalModerator',
          'repliesCount',
          'isPinned',
          'status',
          'rejectionReason',
          'reviewedBy',
          'reviewedAt',
          'createdAt',
          'lastReplyAt',
          'source',
          'isSpotTopic',
          'spotId',
          'temporarySpotId',
          'temporarySpotStartsAt',
          'temporarySpotExpiresAt',
          'autoExpiresAt'
        ])
        && (
          request.resource.data.authorId == currentUid()
          || validTemporarySpotAutoForumTopicCreate(topicId)
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.category is string
        && request.resource.data.categoryId is string
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 1
        && request.resource.data.description.size() <= 2000
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 1200
        && request.resource.data.authorName is string
        && (
          !request.resource.data.keys().hasAny(['authorRole'])
          || request.resource.data.authorRole is string
        )
        && (
          !request.resource.data.keys().hasAny(['authorVerified'])
          || request.resource.data.authorVerified is bool
        )
        && (
          !request.resource.data.keys().hasAny(['authorGlobalChatModerator'])
          || request.resource.data.authorGlobalChatModerator is bool
        )
        && (
          !request.resource.data.keys().hasAny(['authorGlobalModerator'])
          || request.resource.data.authorGlobalModerator is bool
        )
        && (
          !request.resource.data.keys().hasAny(['source'])
          || (
            request.resource.data.source == 'temporary_spot'
            && request.resource.data.get('isSpotTopic', true) == true
            && request.resource.data.spotId is string
            && request.resource.data.spotId.size() >= 1
            && request.resource.data.temporarySpotId == request.resource.data.spotId
            && topicId == 'temporary_spot_' + request.resource.data.spotId
            && request.resource.data.temporarySpotStartsAt is timestamp
            && request.resource.data.temporarySpotExpiresAt is timestamp
            && request.resource.data.autoExpiresAt == request.resource.data.temporarySpotExpiresAt
          )
        )
        && request.resource.data.repliesCount == 0
        && request.resource.data.isPinned == false
        && (
          (
            request.resource.data.status == 'pending'
            && request.resource.data.rejectionReason == null
            && request.resource.data.reviewedBy == null
            && request.resource.data.reviewedAt == null
          )
          || (
            (isStaff() || validTemporarySpotAutoForumTopicCreate(topicId))
            && request.resource.data.status == 'approved'
            && request.resource.data.rejectionReason == null
            && request.resource.data.reviewedBy == currentUid()
            && request.resource.data.reviewedAt == request.time
          )
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastReplyAt == request.time;

      allow update: if isStaff()
        || isGlobalModerator()
        || (
          isActiveUser()
          && resource.data.authorId == currentUid()
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.status == resource.data.status
          && request.resource.data.isPinned == resource.data.isPinned
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title',
            'description',
            'avatarUrl',
            'updatedAt'
          ])
        );

      allow delete: if isStaff()
        || isGlobalModerator()
        || (
          isActiveUser()
          && resource.data.authorId == currentUid()
        );

      match /replies/{replyId} {
        allow read: if isActiveUser();

        allow create: if isActiveUser()
          && request.resource.data.userId == currentUid()
          && request.resource.data.username is string
          && request.resource.data.avatarUrl is string
          && request.resource.data.text is string
          && (
            request.resource.data.text.size() >= 1
            || request.resource.data.get('photoUrl', request.resource.data.get('imageUrl', '')) is string
          )
          && (
            !request.resource.data.keys().hasAny(['photoUrl'])
            || (
              request.resource.data.photoUrl is string
              && request.resource.data.photoUrl.size() >= 1
              && request.resource.data.photoUrl.size() <= 1500
            )
          )
          && (
            !request.resource.data.keys().hasAny(['imageUrl'])
            || (
              request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.size() >= 1
              && request.resource.data.imageUrl.size() <= 1500
            )
          )
          && (
            !request.resource.data.keys().hasAny(['type'])
            || request.resource.data.type in ['text', 'image']
          )
          && request.resource.data.timestamp == request.time;

        allow update: if isStaff()
          || isGlobalModerator()
          || forumTopicData(topicId).authorId == currentUid()
          || (
            isActiveUser()
            && resource.data.userId == currentUid()
          );

        allow delete: if isStaff()
          || isGlobalModerator()
          || forumTopicData(topicId).authorId == currentUid()
          || (
            isActiveUser()
            && resource.data.userId == currentUid()
          );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
